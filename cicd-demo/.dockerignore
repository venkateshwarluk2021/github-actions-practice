
# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Python packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Testing, coverage and linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Git and editor files
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Secrets and environment files
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Local databases and runtime files
*.sqlite
*.sqlite3
*.db
*.pid

# CI/CD configuration - not needed inside the image
.github/
.gitlab-ci.yml
Jenkinsfile

# Docker-related files not needed inside the image
.dockerignore
docker-compose*.yml
compose*.yaml

# Documentation (optional)
README.md
docs/
